@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

abstract class Item {
  - title : String
  - catalogueNumber : String
  + Item(String: title, String catalogueNumber)
  + getTitle() : String
  + getCatalogueNumber() : String
}

abstract class Borrowable {
  - borrowed : boolean
  - borrowWeek : int
  + Borrowable(int borrowWeek)
  + getBorrowWeek() : int
  + borrow()
  + unborrow()
}

class Book {
}

class DVD {
}

class ReferenceOnly {
}

abstract class User {
  - idNumber : int
  + User(int idNumber)
}

class Member {
  - itemBorrowed : Item[]
  - fee : double
  + Member(int idNumber)
  + borrowItem(Item item)
  + setFee() : void
}

class Librarian {
  - items : Item[]
  + Librarian(int idNumber)
  + waive(Member member)
  + addItem(Item item)
}

' Inheritance (Generalization)
Item <|-- Borrowable
Borrowable <|-- Book
Borrowable <|-- DVD
Item <|-- ReferenceOnly
User <|-- Member
User <|-- Librarian

' Associations and dependencies
Member --> Item
Librarian --> Item
Librarian ..> Member

@enduml